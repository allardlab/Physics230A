// The environment a student gets when they open the published repository in a GitHub Codespace.
//
// The point of it is that we control the image, so "it works on my machine" and "it works for the student" are the same claim: uv sync builds the .venv from the same pyproject.toml and uv.lock that produced the figures baked into the published html.
//
// This file is copied into the published repository by scripts/publish.sh and is never built here.
// There is no Docker on the authoring machine, and nothing local needs one --- local work uses .venv directly, at a few hundred MB against several GB for a container that would only duplicate it.
{
  "name": "Physics 230A/146A --- Biological Physics",

  // Matches .python-version at the repo root.
  // uv would happily fetch its own interpreter, but starting from the right one keeps `uv sync` to a single dependency install on first open.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",

  "features": {
    // JupyterLab, installed the way GitHub documents rather than with pip.
    //
    // This is what makes the "Open in JupyterLab" menu entry work.
    // Installing it with `pip install jupyterlab` in postCreateCommand does put it in the container --- and an interactive terminal finds it --- but the scripts land in ~/.local/bin, which is not on the PATH of the non-interactive launcher GitHub uses, and the entry fails with "we were unable to connect to your codespace in JupyterLab".
    //
    // `version: none` because the base image already supplies python; this feature is here only for the JupyterLab it installs.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "none",
      "installJupyterlab": true
    },

    // Quarto; TinyTeX is installed later, by the `tex` step of postCreateCommand, not by this feature's `installTinyTex` option.
    //
    // That option was tried, and it took every Codespace down: before installing TinyTeX the feature runs `apt-get update`, and the base image carries a Yarn apt source whose signing key apt cannot verify (NO_PUBKEY 62D54FD4003F6525), which apt treats as fatal.
    // A feature that fails fails the image build, and GitHub then hands the student a bare recovery container with nothing in it.
    // Without the option this feature never calls apt, which is the build that has always worked; and a lifecycle step that fails only logs an error, with the Codespace otherwise intact.
    //
    // This does not make the Codespace able to run scripts/deploy.sh: that also needs inkscape, to derive each figure's svg, and the Codespace has none.
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {}
  },

  // Belt and braces for the PATH problem described above: anything pip installed for the container user stays reachable, whoever is doing the launching.
  //
  // The two TinyTeX directories are there for the same reason.
  // `quarto install tinytex` links its binaries into ~/bin, which Debian only puts on PATH for a login shell, and LaTeX Workshop launches latexmk from the extension host, which is not one.
  // Both architectures are named because a Codespace is x86_64 but a local dev container on Apple silicon is not, and a directory that does not exist costs nothing on PATH.
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin:/home/vscode/bin:/home/vscode/.TinyTeX/bin/x86_64-linux:/home/vscode/.TinyTeX/bin/aarch64-linux"
  },

  // Two named steps, which the dev container spec runs in parallel: `python` for the notebooks and `tex` for the .tex files.
  // Separate so that a CTAN mirror having a bad day can fail the `tex` step without holding up, or failing, the part of the Codespace every student uses.
  //
  // `python`, three commands, and the second and third are what make "Open in JupyterLab" work.
  //
  // 1. uv is installed rather than assumed: the base image has pip but no uv.
  //    `uv sync --frozen` refuses to update the lockfile, so a Codespace can never quietly resolve different versions than the ones that built the site.
  //
  // 2. The venv registered as a named kernel, so the JupyterLab installed by the feature above can see it.
  //    Without this a student opening a notebook in JupyterLab gets the bare system python, which has no numpy, and the notebook fails on its first import while the same file runs perfectly in the VSCode UI beside it.
  //
  // `tex`, TinyTeX itself, then the LaTeX packages the .tex files load, plus latexmk, which is how LaTeX Workshop builds by default.
  // TinyTeX goes into ~/.TinyTeX, as the feature's option would have put it, but without the apt step that broke the build; see the Quarto feature above.
  // pdflatex needs nothing from apt, and pdflatex is what LaTeX Workshop runs.
  // The list is measured rather than guessed: every file TeX read while pdflatex compiled PS1, PS5 and python-test-drive, each mapped to its TeX Live package.
  // Most are already in TinyTeX, and `tlmgr install` of an installed package does nothing, so the list is the whole set rather than only the gaps --- that way it stays right when TinyTeX's own set changes.
  // Re-measure it if the problem sets' Latex header or Quarto's template changes what they load.
  // pdflatex rather than xelatex is what gets measured because it is latexmk's default, and the .tex files choose their fonts with `iftex` so either engine works.
  "postCreateCommand": {
    "python": "pip install --no-cache-dir uv && uv sync --frozen && uv run python -m ipykernel install --user --name p230a --display-name 'Python (Physics 230A)'",
    "tex": "quarto install tinytex --no-prompt && $HOME/.TinyTeX/bin/*/tlmgr install latexmk amsfonts amsmath atbegshi atveryend auxhook bigintcalc bitset bookmark booktabs caption cm ec epstopdf-pkg etexcmds etoolbox fancyvrb float fontname footmisc footnotehyper framed gettitlestring graphics graphics-cfg graphics-def hycolor hyperref iftex infwarerr intcalc koma-script kpathsea kvdefinekeys kvoptions kvsetkeys l3backend latex latexconfig letltxmacro lm ltxcmds microtype mptopdf pdfescape pdftexcmds refcount rerunfilecheck tools uniquecounter upquote url xcolor xurl"
  },

  "customizations": {
    // Deliberately NO `codespaces: { openFiles: [...] }` here, though the README is meant to open first.
    //
    // openFiles opens a file as a plain text editor, so the README arrived as raw markdown, whose links cannot be clicked --- and it fires first, pre-empting `workbench.startupEditor: "readme"` in .vscode/settings.json, which is the setting that opens it rendered.
    // The README is the navigation surface, an index of the notebooks and the problem sets' .tex files, so the rendered view is the point, and startupEditor alone gives it.
    // Found first in ../MCSBBootcamp_dev, and then again here from a Codespace that opened on the markdown source.

    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "quarto.quarto",
        // Compiles a problem set's or notebook's .tex with the TinyTeX above.
        // Left on its default recipe, latexmk with pdflatex, which is the one the `tex` step's package list was measured against, so it needs no settings.
        "james-yu.latex-workshop"
      ],
      // Editor settings are NOT here.
      // They live in .vscode/settings.json, which reaches a student with a `git pull` rather than a container rebuild --- see the note at the top of that file.
      // Only the extension list stays, since that genuinely is a property of the container.
      // The one exception to "editor settings live in .vscode/settings.json": the AI chat panel, set in both places.
      // Settings given here are machine settings, applied when the container is created, whereas the workspace file is read only once the window has opened --- and a Codespace was seen opening with the chat panel showing on the right despite the workspace file hiding it.
      // Other educators report the same, and that the panel can still flash up while the codespace is first building; nothing configurable reaches that early.
      "settings": {
        "python.terminal.activateEnvironment": true,
        "chat.disableAIFeatures": true,
        "workbench.secondarySideBar.defaultVisibility": "hidden"
      }
    }
  },

  // JupyterLab's default port.
  // Start it from a terminal in the Codespace with:  uv run jupyter lab
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "JupyterLab", "onAutoForward": "notify" }
  }
}
